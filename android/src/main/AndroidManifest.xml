<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required on Android 11+ (API 30+) so PackageManager can see Instagram -->
    <queries>
        <package android:name="com.instagram.android" />
    </queries>

    <application>
        <provider
            android:name="com.milanciganovic.instagram_share_plus.InstagramShareProvider"
            android:authorities="${applicationId}.instagramshare.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>